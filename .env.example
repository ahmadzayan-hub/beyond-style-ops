# Beyond Style Agent — environment variables
# Copy this file to .env and fill in real values. NEVER commit .env to git.
# Core order verification works without any of these (dry-run mode).

# ── Beyond Style Business WhatsApp Number ────────────────────────────────────
# The number customers receive messages FROM. E.164, no + sign.
BUSINESS_WHATSAPP_NUMBER=971551556991

# ── WhatsApp Business Cloud API (Meta) ───────────────────────────────────────
# HOW TO GET THESE:
# 1. https://developers.facebook.com → My Apps → Create App → Business
# 2. Add "WhatsApp" product to your app
# 3. WhatsApp → API Setup → register 0551556991
# 4. Copy "Phone Number ID" (long numeric ID) → WHATSAPP_PHONE_NUMBER_ID
# 5. Copy access token → WHATSAPP_API_TOKEN
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Owner Escalation ──────────────────────────────────────────────────────────
# Owner's personal WhatsApp for High Risk / Needs Correction alerts.
OWNER_WHATSAPP_NUMBER=

# ── Google Sheets ─────────────────────────────────────────────────────────────
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── Optional ──────────────────────────────────────────────────────────────────
# Force dry-run even when API credentials are present.
DRY_RUN=

# ── Web app on Vercel (api/index.py) ─────────────────────────────────────────
# Set these in Vercel → Project → Settings → Environment Variables (Production).
# The app refuses every sign-in until APP_PASSWORD and SESSION_SECRET are both set.
APP_PASSWORD=
SESSION_SECRET=
# Google OAuth refresh token for the Sheets API (from the owner's token file, never committed)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Optional, defaults shown in ops/sheets.py
# GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/spreadsheets
# GOOGLE_OAUTH_TOKEN_URI=https://oauth2.googleapis.com/token
